{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fintrack.app"
    },
    "android": {
      "package": "com.fintrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font"
    ],
    "assetBundlePatterns": [
      "assets/**"
    ],
    "scheme": "fintrack",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb257448-c12c-4181-b056-9ecd79ebfde9"
      }
    },
    "owner": "excelv"
  }
}
